<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>nossl.sh — Captive portal trigger and diagnostics</title>
    <meta
      name="description"
      content="Trigger captive portals, inspect headers, and confirm Wi‑Fi connectivity with a clean HTTP-only diagnostics hub."
    />
    <meta
      name="keywords"
      content="never ssl, nossl, captive portal, wifi login page, http test, network diagnostics"
    />
    <meta property="og:title" content="nossl.sh — HTTP-only diagnostic workspace" />
    <meta
      property="og:description"
      content="Measure latency, copy request headers, and launch captive portals instantly with nossl.sh."
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="http://nossl.sh/" />
    <meta property="og:site_name" content="nossl.sh" />
    <meta property="og:image" content="/static/og-image.png" />
    <meta property="og:image:alt" content="Gradient banner for nossl.sh" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="nossl.sh — HTTP-only diagnostic workspace" />
    <meta
      name="twitter:description"
      content="Trigger captive portals, verify Wi‑Fi, and capture request headers without HTTPS."
    />
    <meta name="twitter:image" content="/static/og-image.png" />
    <meta name="twitter:image:alt" content="Gradient banner for nossl.sh" />
    <link rel="icon" href="/favicon.ico" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;700&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/static/styles.css" />
  </head>
  <body>
    <div class="background">
      <div class="blur blob-1"></div>
      <div class="blur blob-2"></div>
    </div>
    <div class="page">
      <header class="nav">
        <div class="nav__brand">
          <div class="brand-mark">n</div>
          <div>
            <p class="brand-name">nossl.sh</p>
            <p class="brand-sub">HTTP-only diagnostics</p>
          </div>
        </div>
        <div class="nav__actions">
          <a class="chip" href="/api/request-info" rel="nofollow">Request JSON</a>
          <a class="chip" href="/honeypot">Honeypot console</a>
        </div>
      </header>

      <main class="main">
        <section class="hero">
          <div class="hero__content">
            <p class="eyebrow">Captive portal unlocker</p>
            <h1>Force the splash page. Verify what your device sends.</h1>
            <p class="lede">
              Open <strong>http://nossl.sh</strong> to bypass HTTPS blocks, surface hotel or airport Wi‑Fi login screens, and grab a
              pristine snapshot of your request headers.
            </p>
            <div class="hero__actions">
              <button type="button" class="btn" data-copy-curl aria-label="Copy curl command">
                Copy curl command
              </button>
              <% if (shareReportEnabled) { %>
              <button type="button" class="btn btn--ghost" data-share-report data-share-url="<%= shareReportUrl %>">
                Share diagnostic link
              </button>
              <% } %>
            </div>
            <% if (shareReportEnabled) { %>
            <p class="micro" data-share-status>Ready to share: <%= shareReportUrl %></p>
            <% } else { %>
            <p class="micro">Share links are temporarily unavailable.</p>
            <% } %>
          </div>
          <div class="hero__panel">
            <div class="status-chip <%= scheme === 'https' ? 'status-chip--secure' : 'status-chip--open' %>">
              <span class="dot"></span>
              <%= status %>
            </div>
            <div class="hero__grid">
              <div class="stat">
                <p class="label">Protocol</p>
                <p class="value mono"><%= scheme.toUpperCase() %></p>
              </div>
              <div class="stat">
                <p class="label">Client IP</p>
                <p class="value mono"><%= clientIp %></p>
              </div>
              <div class="stat">
                <p class="label">Timestamp</p>
                <p class="value mono"><%= generatedAt.toISOString().replace('T', ' ').replace(/\..+/, ' UTC') %></p>
              </div>
              <div class="stat">
                <p class="label">Latency</p>
                <p class="value mono" data-api-latency aria-live="polite">Measuring…</p>
              </div>
            </div>
            <div class="meta">
              <div>
                <p class="meta__label">Requests served</p>
                <p class="meta__value mono"><%= totalRequests.toLocaleString('en-US') %></p>
              </div>
              <div>
                <p class="meta__label">Render time</p>
                <p class="meta__value mono"><%= typeof generationTimeMs === 'number' ? generationTimeMs.toFixed(2) + ' ms' : 'N/A' %></p>
              </div>
            </div>
          </div>
        </section>

        <section class="grid">
          <article class="card">
            <header class="card__header">
              <div>
                <p class="eyebrow">Network facts</p>
                <h2>Connection snapshot</h2>
              </div>
              <button type="button" class="chip chip--outline" data-copy-headers aria-label="Copy request headers as JSON">
                Copy headers JSON
              </button>
            </header>
            <div class="card__body">
              <div class="table-wrapper">
                <table class="headers">
                  <thead>
                    <tr>
                      <th scope="col">Header</th>
                      <th scope="col">Value</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% headers.forEach(([key, value]) => { %>
                    <tr>
                      <th scope="row"><%= key %></th>
                      <td><%= value %></td>
                    </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
            </div>
          </article>

          <article class="card card--stacked">
            <header class="card__header">
              <div>
                <p class="eyebrow">Quick tools</p>
                <h2>Resolve captive portal issues</h2>
              </div>
            </header>
            <div class="card__body tools">
              <div class="tool">
                <p class="label">cURL check</p>
                <p class="tool__desc">Copy a ready-to-run snippet to verify your public IP over HTTP.</p>
                <div class="code">
                  <code>$ curl http://nossl.sh</code>
                  <button type="button" class="chip" data-copy-curl>Copy</button>
                </div>
              </div>
              <div class="tool">
                <p class="label">Honeypot console</p>
                <p class="tool__desc">Review noisy /.env scans and suspicious traffic patterns.</p>
                <a class="chip" href="/honeypot">Open console</a>
              </div>
              <div class="tool">
                <p class="label">Guides library</p>
                <p class="tool__desc">Detailed steps for hotels, cafés, and mobile captive portals.</p>
                <div class="pill-links">
                  <a class="chip" href="/guides">Browse guides</a>
                  <a class="chip chip--outline" href="/captive-portal">Captive portal</a>
                </div>
              </div>
            </div>
          </article>
        </section>

        <section class="card card--wide">
          <header class="card__header">
            <div>
              <p class="eyebrow">Support</p>
              <h2>Why this page exists</h2>
            </div>
          </header>
          <div class="card__body content">
            <p>
              nossl.sh intentionally avoids HTTPS and HSTS so captive portals can intercept the request, show their splash screen,
              and complete authentication. It doubles as a troubleshooting panel for latency, IP visibility, and what headers your
              device transmits.
            </p>
            <p>
              Still stuck? Toggle Wi‑Fi off and on, disable VPNs or custom DNS profiles, and retry in a private browser window.
              Keep this page open to confirm when the network becomes reachable.
            </p>
            <div class="faq">
              <div class="faq__item">
                <p class="faq__question">Why won't the Wi‑Fi login page load?</p>
                <p class="faq__answer">
                  Networks sometimes block HTTPS handshakes. Loading <a href="http://nossl.sh">http://nossl.sh</a> sends a plain
                  HTTP request that usually triggers the captive portal prompt.
                </p>
              </div>
              <div class="faq__item">
                <p class="faq__question">What URL forces Wi‑Fi login?</p>
                <p class="faq__answer">
                  Use <a href="http://nossl.sh">http://nossl.sh</a>. It is lightweight, unencrypted, and intentionally lacks HSTS
                  to expose captive redirect flows.
                </p>
              </div>
              <div class="faq__item">
                <p class="faq__question">How do I connect after signing in?</p>
                <p class="faq__answer">
                  After the splash page appears and you accept terms, refresh this dashboard. The latency tile will update and the
                  request headers should show your assigned IP.
                </p>
              </div>
            </div>
          </div>
        </section>
      </main>

      <footer class="footer">
        <div class="footer__copy">
          <p>Generated at <span class="mono"><%= generatedAt.toISOString().replace('T', ' ').replace(/\..+/, ' UTC') %></span></p>
          <p>
            Prefer JSON? Try the <a href="/api/request-info" rel="nofollow">request info endpoint</a> for scripting and
            monitoring.
          </p>
        </div>
      </footer>
    </div>

    <script>
      const latencyEl = document.querySelector('[data-api-latency]');
      const headersCopyButton = document.querySelector('[data-copy-headers]');
      const curlCopyButton = document.querySelectorAll('[data-copy-curl]');

      if (latencyEl) {
        const startedAt = performance.now();
        fetch('/api/request-info', { headers: { Accept: 'application/json' } })
          .then((response) => {
            const elapsed = Math.round(performance.now() - startedAt);
            latencyEl.textContent = `${elapsed} ms`;

            if (!response.ok) {
              throw new Error('Response not OK');
            }
          })
          .catch(() => {
            latencyEl.textContent = 'Unable to measure';
          });
      }

      const fallbackCopyText = (text) => {
        const textarea = document.createElement('textarea');
        textarea.value = text;
        textarea.setAttribute('readonly', '');
        textarea.style.position = 'absolute';
        textarea.style.left = '-9999px';
        document.body.appendChild(textarea);

        const selection = window.getSelection();
        if (selection && selection.rangeCount) {
          selection.removeAllRanges();
        }

        textarea.select();

        let successful;
        try {
          successful = document.execCommand('copy');
        } catch (error) {
          successful = false;
        }

        document.body.removeChild(textarea);
        return successful;
      };

      const copyText = async (text) => {
        if (navigator.clipboard && typeof navigator.clipboard.writeText === 'function') {
          try {
            await navigator.clipboard.writeText(text);
            return true;
          } catch (error) {
            // fall back to execCommand
          }
        }

        return fallbackCopyText(text);
      };

      const shareButton = document.querySelector('[data-share-report]');
      const shareStatus = document.querySelector('[data-share-status]');

      const setShareStatus = (text) => {
        if (!shareStatus) {
          return;
        }
        shareStatus.textContent = text;
      };

      if (shareButton) {
        const shareUrl = shareButton.getAttribute('data-share-url') || '';
        if (shareUrl) {
          setShareStatus(`Ready to share: ${shareUrl}`);
        } else {
          shareButton.disabled = true;
        }

        const resetShareButton = () => {
          shareButton.textContent = 'Share diagnostic link';
          shareButton.disabled = false;
        };

        shareButton.addEventListener('click', async () => {
          if (!shareUrl) {
            return;
          }
          shareButton.textContent = 'Copying…';
          shareButton.disabled = true;
          try {
            const copied = await copyText(shareUrl);
            shareButton.textContent = copied ? 'Link copied' : 'Copy failed';
            setShareStatus(shareUrl);
          } catch (error) {
            shareButton.textContent = 'Unavailable';
            setShareStatus('Sharing is temporarily unavailable.');
          } finally {
            setTimeout(resetShareButton, 2500);
          }
        });
      }

      if (headersCopyButton) {
        const headerPairs = <%- JSON.stringify(headers) %>;
        const headersPayload = headerPairs.reduce((acc, [key, value]) => {
          if (acc[key]) {
            acc[key] = Array.isArray(acc[key]) ? [...acc[key], value] : [acc[key], value];
          } else {
            acc[key] = value;
          }
          return acc;
        }, {});

        headersCopyButton.addEventListener('click', async () => {
          const copied = await copyText(JSON.stringify(headersPayload, null, 2));
          headersCopyButton.textContent = copied ? 'Copied!' : 'Copy failed';
          setTimeout(() => {
            headersCopyButton.textContent = 'Copy headers JSON';
          }, 2000);
        });
      }

      if (curlCopyButton && curlCopyButton.length) {
        const curlCommand = 'curl http://nossl.sh';

        curlCopyButton.forEach((button) => {
          const resetLabel = () => {
            button.textContent = button.classList.contains('btn') ? 'Copy curl command' : 'Copy';
          };

          button.addEventListener('click', async () => {
            const copied = await copyText(curlCommand);
            button.textContent = copied ? 'Copied!' : 'Copy failed';
            setTimeout(resetLabel, 2000);
          });
        });
      }
    </script>
  </body>
</html>
