<!DOCTYPE html>
<html lang="en">
  <head>
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "SoftwareApplication",
        "name": "nossl.sh",
        "applicationCategory": "DeveloperApplication",
        "operatingSystem": "Windows, macOS, Linux",
        "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
        "url": "https://nossl.sh/",
        "publisher": {
          "@type": "Organization",
          "name": "nossl.sh",
          "url": "https://nossl.sh/"
        }
      }
    </script>
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "Why won't the Wi-Fi login page load?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Captive portals sometimes block HTTPS handshakes or VPN/DNS profiles. Open http://nossl.sh in your browser, turn off VPNs, and retry so the network can show its sign-in splash screen."
            }
          },
          {
            "@type": "Question",
            "name": "What is the URL to force Wi-Fi login?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Visit http://nossl.sh to trigger most captive portal login pages because it intentionally serves plain HTTP without HSTS."
            }
          },
          {
            "@type": "Question",
            "name": "How do I connect to the Wi-Fi login page?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Turn off VPNs, then visit http://nossl.sh in a browser to trigger the captive portal. If it does not appear, reload, try a private window, or toggle Wi-Fi off/on."
            }
          }
        ]
      }
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="nossl.sh helps you diagnose no SSL connection issues, check your Wi-Fi, verify internet access, troubleshoot captive portal login pages, and inspect the headers your device sends."
    />
    <meta
      name="keywords"
      content="no ssl, nossl, never ssl alternative, captive portal login, hotel wifi login, airport wifi, coffee shop wifi, http test page"
    />
    <meta property="og:title" content="nossl.sh - Force Wifi Login, Check IP & Headers (HTTP Only)" />
    <meta
      property="og:description"
      content="nossl.sh helps you diagnose no SSL connection issues, check your Wi-Fi, verify internet access, troubleshoot captive portal login pages, and inspect the headers your device sends."
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="http://nossl.sh/" />
    <meta property="og:site_name" content="nossl.sh" />
    <meta property="og:image" content="/static/og-image.png" />
    <meta property="og:image:alt" content="Abstract teal and navy banner for nossl.sh" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="nossl.sh - Force Wifi Login, Check IP & Headers (HTTP Only)" />
    <meta
      name="twitter:description"
      content="nossl.sh helps you diagnose no SSL connection issues, check your Wi-Fi, verify internet access, troubleshoot captive portal login pages, and inspect the headers your device sends."
    />
    <meta name="twitter:image" content="/static/og-image.png" />
    <meta name="twitter:image:alt" content="Abstract teal and navy banner for nossl.sh" />
    <title>nossl.sh - Connection &amp; Header Diagnostics</title>
    <link rel="icon" href="/favicon.ico" type="image/svg+xml" />
    <link rel="stylesheet" href="/static/styles.css?v=2" />
  </head>
  <body>
    <% 
      const formattedGeneratedAt = generatedAt.toISOString().replace('T', ' ').replace(/\..+/, ' UTC');
      const headerCount = headers.length;
      const schemeLabel = scheme === 'https' ? 'HTTPS (TLS)' : 'HTTP (no TLS)';
      const httpLabel = (httpVersion ? `HTTP/${httpVersion}` : 'HTTP/1.1') + ' · ' + schemeLabel;
      const requestLabel = `${requestMethod} ${requestPath}`;
      const localLabel = localAddress ? `${localAddress}${localPort ? ':' + localPort : ''}` : '—';
      const remoteLabel = remoteAddress ? `${remoteAddress}${remotePort ? ':' + remotePort : ''}` : '—';
      const headerNote = '// Trigger the captive hotel/airport Wi‑Fi login page, never HTTPS, never SSL';
      const footerLines = [
        `Prefer JSON? Try the <a href="/api/request-info" rel="nofollow">request info API endpoint</a>. Total requests served: <span class="mono">${totalRequests.toLocaleString('en-US')}</span>`
      ];
      var geoSummary = (geo && geo.countryName)
        ? [
            geo.countryFlag,
                  // geo.countryCode ? `(${geo.countryCode})` : null,
            geo.countryName
          ]
            .filter(Boolean)
            .join(' ')
        : null;
      if (geoSummary && geo.orgName) {
          geoSummary += " / " + geo.orgName;
      }
    %>
    <%- include('partials/header', {headerNote}) %>

    <main class="container page">
      <section aria-labelledby="connection-report" class="card hero">
        <div class="card__header">
          <div>
            <p class="eyebrow">Live snapshot</p>
            <h1 id="connection-report" class="card__title">Connection report</h1>
          </div>
          <div class="card__actions">
            <% if (shareReportEnabled) { %>
              <button type="button" class="btn btn-outline" data-share-report data-share-url="<%= shareReportUrl %>">Share</button>
            <% } %>
          </div>
        </div>
        <div class="hero-grid">
          <div class="hero-primary">
            <p class="label">IP address</p>
            <div class="ip-row">
              <span class="ip-value mono"><%= clientIp %></span>
              <button type="button" class="btn btn-ghost" data-copy-text="<%= clientIp %>">Copy</button>
            </div>
              <% if (geoSummary )  { %>
            <p class="ip-location mono">
                <%= geoSummary %>
            </p>
              <% } %>
              <dl class="meta-grid meta-grid--compact hero-meta">
              <div>
                <dt>🌐 Protocol</dt>
                <dd class="mono"><%= httpLabel %></dd>
              </div>
            </dl>
          </div>
          <div class="hero-secondary">
            <dl class="meta-grid meta-grid--compact">
              <div>
                <dt>📡 Ping</dt>
                <dd class="mono" data-api-latency aria-live="polite">Measuring…</dd>
              </div>
              <div>
                <dt>🧾 Headers captured</dt>
                <dd><%= headerCount %></dd>
              </div>
              <div>
                <dt>🕒 Generated</dt>
                <dd><%= formattedGeneratedAt %></dd>
              </div>
            </dl>
          </div>
        </div>
      </section>

      <section aria-labelledby="request-headers" class="card collapsible">
        <div class="card__header card__header--toggle">
          <div>
            <p class="eyebrow">Headers</p>
            <h2 id="request-headers" class="card__title">Request headers</h2>
          </div>
          <div class="header-actions">
            <span class="pill pill-muted"><%= headerCount %> headers</span>
            <button type="button" class="btn btn-outline toggle" data-toggle-headers aria-expanded="false" data-expanded="false" aria-controls="headers-content">
              <span data-toggle-label>Show</span>
              <span class="chevron" aria-hidden="true"></span>
            </button>
            <button type="button" class="btn btn-ghost" data-copy-headers>Copy JSON</button>
          </div>
        </div>
        <div class="collapsible__content" id="headers-content" hidden>
          <div class="table-wrapper headers-table-wrapper">
            <table class="headers-table">
              <thead>
                <tr>
                  <th scope="col">Header</th>
                  <th scope="col">Value</th>
                </tr>
              </thead>
              <tbody>
                <% headers.forEach(([key, value]) => { %>
                <tr>
                  <th scope="row"><span class="mono"><%= key %></span></th>
                  <td><span class="mono"><%= value %></span></td>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <div class="info-grid">
        <section class="card info-card" aria-labelledby="how-to-use">
          <p class="eyebrow">How to use this page</p>
          <h3 id="how-to-use" class="card__title">Plain HTTP for quick checks</h3>
          <p class="muted">See your real IP, request method, and headers without HTTPS in the way. Great for captive portals, firewall tests, or debugging VPN/proxy quirks.</p>
          <ul class="bullets">
            <li>Open http://nossl.sh to trigger captive portal pages.</li>
            <li>Share a snapshot link if support needs proof.</li>
          </ul>
          <p class="muted">Need step-by-step help? Browse the <a href="/guides">full guide index</a> for hotels, cafes, and mobile walkthroughs.</p>
          <ul class="bullets">
            <li><a href="/captive-portal">Captive portal diagnostics</a></li>
            <li><a href="/wifi-login-page">Wi‑Fi login page tester</a></li>
            <li><a href="/mobile-wifi">Mobile Wi‑Fi troubleshooting</a></li>
          </ul>
        </section>

        <section class="card info-card" aria-labelledby="curl-examples">
          <p class="eyebrow">cURL examples</p>
          <h3 id="curl-examples" class="card__title">Quick command line checks</h3>
          <p class="muted">Returns your public IP only — similar to <code class="mono">ifconfig.me</code>.</p>
          <div class="code-block">
            <code class="mono">$ curl http://nossl.sh</code>
            <button type="button" class="btn btn-outline btn-small" data-copy-text="curl http://nossl.sh">Copy</button>
            <div class="code-example mono">→ <%= clientIp %></div>
          </div>
          <p class="muted">API references:</p>
          <ul class="bullets">
            <li><a href="/api/request-info" rel="nofollow">/api/request-info</a> — current IP, scheme, headers.</li>
            <li><a href="/api/counters" rel="nofollow">/api/counters</a> — request counters snapshot.</li>
            <li><a href="/api/honeypot" rel="nofollow">/api/honeypot</a> — honeypot hits as JSON.</li>
          </ul>
          <p class="muted">Need the honeypot console? Visit the <a href="/honeypot">/honeypot</a> dashboard.</p>
        </section>

        <section class="card info-card" aria-labelledby="faq">
          <p class="eyebrow">FAQ</p>
          <h3 id="faq" class="card__title">Why plain HTTP?</h3>
          <dl class="faq">
            <dt>Why no TLS?</dt>
            <dd>Captive portals and restrictive networks often block HTTPS handshakes. HTTP keeps the splash page visible.</dd>
            <dt>What can I use this for?</dt>
            <dd>Spot VPN or proxy issues, capture headers for debugging, and confirm whether the network is online.</dd>
            <dt>Is there an API?</dt>
            <dd>Yes — use the <a href="/api/request-info" rel="nofollow">request info endpoint</a> for JSON.</dd>
          </dl>
        </section>
      </div>
    </main>

    <%- include('partials/footer', {formattedGeneratedAt, generationTimeMs, footerLines}) %>

    <script>
      (() => {
        const latencyEl = document.querySelector('[data-api-latency]');
        const headersCopyButton = document.querySelector('[data-copy-headers]');
        const headersToggleButton = document.querySelector('[data-toggle-headers]');
        const shareButton = document.querySelector('[data-share-report]');

        const fallbackCopyText = (text) => {
          const textarea = document.createElement('textarea');
          textarea.value = text;
          textarea.setAttribute('readonly', '');
          textarea.style.position = 'absolute';
          textarea.style.left = '-9999px';
          document.body.appendChild(textarea);
          textarea.select();

          let successful;
          try {
            successful = document.execCommand('copy');
          } catch (error) {
            successful = false;
          }

          document.body.removeChild(textarea);
          return successful;
        };

        const copyText = async (text) => {
          if (!text) {
            return false;
          }
          if (navigator.clipboard && typeof navigator.clipboard.writeText === 'function') {
            try {
              await navigator.clipboard.writeText(text);
              return true;
            } catch (error) {
              // fall back to execCommand
            }
          }
          return fallbackCopyText(text);
        };

        const flashButton = (button, label) => {
          if (!button) return;
          const originalLabel = button.textContent.trim();
          button.textContent = label;
          button.disabled = true;
          setTimeout(() => {
            button.textContent = originalLabel;
            button.disabled = false;
          }, 2000);
        };

        if (latencyEl) {
          const startedAt = performance.now();
          fetch('/healthz', { headers: { Accept: 'application/json' } })
            .then((response) => {
              const elapsed = Math.round(performance.now() - startedAt);
              latencyEl.textContent = `${elapsed} ms`;
              if (!response.ok) {
                throw new Error('Response not OK');
              }
            })
            .catch(() => {
              latencyEl.textContent = 'Unavailable';
              latencyEl.classList.add('pill-muted');
            });
        }

        document.querySelectorAll('[data-copy-text]').forEach((button) => {
          button.addEventListener('click', async () => {
            const text = button.getAttribute('data-copy-text');
            const copied = await copyText(text);
            flashButton(button, copied ? 'Copied' : 'Copy failed');
          });
        });

        if (headersCopyButton) {
          const headerPairs = <%- JSON.stringify(headers) %>;
          const headersPayload = headerPairs.reduce((acc, [key, value]) => {
            if (acc[key]) {
              acc[key] = Array.isArray(acc[key]) ? [...acc[key], value] : [acc[key], value];
            } else {
              acc[key] = value;
            }
            return acc;
          }, {});

          headersCopyButton.addEventListener('click', async () => {
            const copied = await copyText(JSON.stringify(headersPayload, null, 2));
            flashButton(headersCopyButton, copied ? 'Copied' : 'Copy failed');
          });
        }

        if (headersToggleButton) {
          const targetId = headersToggleButton.getAttribute('aria-controls');
          const content = document.getElementById(targetId);
          const labelEl = headersToggleButton.querySelector('[data-toggle-label]');

          const setState = (expanded) => {
            headersToggleButton.setAttribute('aria-expanded', String(expanded));
            headersToggleButton.dataset.expanded = String(expanded);
            if (content) {
              content.hidden = !expanded;
            }
            if (labelEl) {
              labelEl.textContent = expanded ? 'Hide' : 'Show';
            }
          };

          setState(false);

          headersToggleButton.addEventListener('click', () => {
            const isExpanded = headersToggleButton.getAttribute('aria-expanded') === 'true';
            setState(!isExpanded);
          });
        }

        if (shareButton) {
          const shareUrl = shareButton.getAttribute('data-share-url') || '';

          shareButton.addEventListener('click', async () => {
            if (!shareUrl) {
              return;
            }
            shareButton.textContent = 'Copying...';
            shareButton.disabled = true;
            try {
              const copied = await copyText(shareUrl);
              shareButton.textContent = copied ? 'Link copied' : 'Copy failed';
            } finally {
              setTimeout(() => {
                shareButton.textContent = 'Share';
                shareButton.disabled = false;
              }, 2000);
            }
          });
        }
      })();
    </script>
  </body>
</html>
