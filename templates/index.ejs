<!DOCTYPE html>
<html lang="en">
  <head>
    <script type="application/ld+json">
      {
        "@context":"https://schema.org",
        "@type":"SoftwareApplication",
        "name":"nossl.sh",
        "applicationCategory":"DeveloperApplication",
        "operatingSystem":"Windows, macOS, Linux",
        "offers":{"@type":"Offer","price":"0","priceCurrency":"USD"},
        "url":"https://nossl.sh/",
        "publisher":{
          "@type":"Organization",
          "name":"nossl.sh",
          "url":"https://nossl.sh/"
        }
      }
    </script>
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "Why won't the Wi-Fi login page load?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Captive portals sometimes block HTTPS handshakes or VPN/DNS profiles. Open http://nossl.sh in your browser, turn off VPNs, and retry so the network can show its sign-in splash screen."
            }
          },
          {
            "@type": "Question",
            "name": "What is the URL to force Wi-Fi login?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Visit http://nossl.sh to trigger most captive portal login pages because it intentionally serves plain HTTP without HSTS."
            }
          },
          {
            "@type": "Question",
            "name": "How do I connect to the Wi-Fi login page?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Turn off VPNs, then visit http://nossl.sh in a browser to trigger the captive portal. If it does not appear, reload, try a private window, or toggle Wi-Fi off/on."
            }
          }
        ]
      }
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="nossl.sh helps you diagnose no SSL connection issues, check your Wi-Fi, verify internet access, troubleshoot captive portal login pages, and inspect the headers your device sends."
    />
    <meta
      name="keywords"
      content="no ssl, nossl, never ssl alternative, captive portal login, hotel wifi login, airport wifi, coffee shop wifi, http test page"
    />
    <meta property="og:title" content="nossl.sh - Force Wifi Login, Check IP & Headers (HTTP Only)" />
    <meta
      property="og:description"
      content="nossl.sh helps you diagnose no SSL connection issues, check your Wi-Fi, verify internet access, troubleshoot captive portal login pages, and inspect the headers your device sends."
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="http://nossl.sh/" />
    <meta property="og:site_name" content="nossl.sh" />
    <meta property="og:image" content="/static/og-image.png" />
    <meta property="og:image:alt" content="Abstract teal and navy banner for nossl.sh" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="nossl.sh - Force Wifi Login, Check IP & Headers (HTTP Only)" />
    <meta
      name="twitter:description"
      content="nossl.sh helps you diagnose no SSL connection issues, check your Wi-Fi, verify internet access, troubleshoot captive portal login pages, and inspect the headers your device sends."
    />
    <meta name="twitter:image" content="/static/og-image.png" />
    <meta name="twitter:image:alt" content="Abstract teal and navy banner for nossl.sh" />
    <title>nossl.sh - Connection &amp; Header Diagnostics</title>
    <link rel="icon" href="/favicon.ico" type="image/svg+xml" />
    <link rel="stylesheet" href="/static/styles.css?124" />
  </head>
  <body>
    <header class="site-header">
      <div class="container nav">
        <a class="brand" href="/" aria-label="nossl.sh home">
          <span class="brand__icon" aria-hidden="true">n</span>
          <span class="brand__text">
            <span class="brand__name">nossl.sh</span>
            <span class="brand__tagline">HTTP Request Analyzer</span>
          </span>
        </a>
        <div class="nav__actions">
          <a class="button button--ghost" href="/honeypot">Honeypot</a>
          <% if (shareReportEnabled) { %>
          <button type="button" class="button button--outline" data-share-report data-share-url="<%= shareReportUrl %>">
            Copy share link
          </button>
          <% } %>
          <a class="button button--primary" href="/check">Analyze Request</a>
        </div>
      </div>
    </header>

    <main class="container page">
      <section class="hero">
        <div class="eyebrow">HTTP Request Analyzer</div>
        <h1>Your HTTP Request</h1>
        <p class="lede">Complete analysis of your connection and request details.</p>
        <div class="hero__meta">
          <span class="badge">
            <span class="badge__dot"></span>
            <%= status %>
          </span>
          <span class="muted">Page generated at <%= generatedAt.toISOString().replace('T', ' ').replace(/\..+/, ' UTC') %></span>
        </div>
        <% if (shareReportEnabled) { %>
        <p class="share-status" data-share-status></p>
        <% } %>
      </section>

      <section class="stats">
        <article class="card stat">
          <div class="stat__label">IP Address</div>
          <div class="stat__value mono"><%= clientIp %></div>
          <p class="muted">Detected from your inbound request.</p>
        </article>
        <article class="card stat">
          <div class="stat__label">Response Time</div>
          <div class="stat__value" data-api-latency aria-live="polite">Measuring…</div>
          <p class="muted">Round-trip latency to our request info API.</p>
        </article>
        <article class="card stat">
          <div class="stat__label">Request Details</div>
          <div class="stat__value"><%= scheme.toUpperCase() %></div>
          <p class="muted">Served over <%= scheme.toUpperCase() %> without SSL enforcement.</p>
        </article>
        <article class="card stat">
          <div class="stat__label">Request Method</div>
          <div class="stat__value"><%= requestMethod %></div>
          <p class="muted">Captured as received by the server.</p>
        </article>
      </section>

      <section class="card">
        <header class="card__header">
          <div>
            <p class="eyebrow">Captured</p>
            <h2>Request Headers</h2>
            <p class="muted">The headers we observed on this request.</p>
          </div>
          <button type="button" class="button button--outline" data-copy-headers>
            Copy as JSON
          </button>
        </header>
        <div class="table-wrapper">
          <table>
            <thead>
              <tr>
                <th scope="col">Header</th>
                <th scope="col">Value</th>
              </tr>
            </thead>
            <tbody>
              <% headers.forEach(([key, value]) => { %>
              <tr>
                <th scope="row"><%= key %></th>
                <td><%= value %></td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </section>

      <section class="grid">
        <article class="card">
          <header class="card__header card__header--inline">
            <div>
              <p class="eyebrow">Overview</p>
              <h2>Connection snapshot</h2>
            </div>
            <span class="badge badge--subtle"><%= scheme.toUpperCase() %> detected</span>
          </header>
          <dl class="connection-grid">
            <div>
              <dt>Connection type</dt>
              <dd><%= scheme.toUpperCase() %></dd>
            </div>
            <div>
              <dt>Client IP</dt>
              <dd class="mono"><%= clientIp %></dd>
            </div>
            <div>
              <dt>Page timestamp</dt>
              <dd class="mono"><%= generatedAt.toISOString().replace('T', ' ').replace(/\..+/, ' UTC') %></dd>
            </div>
            <div>
              <dt>Total requests served</dt>
              <dd class="mono"><%= totalRequests.toLocaleString('en-US') %></dd>
            </div>
          </dl>
        </article>

        <article class="card">
          <header class="card__header">
            <div>
              <p class="eyebrow">Tools</p>
              <h2>Quick actions</h2>
              <p class="muted">Use these commands to test captive portals and APIs.</p>
            </div>
          </header>
          <div class="actions-grid">
            <div>
              <h3>Test with curl</h3>
              <p class="muted">Get your real IP with curl:</p>
              <div class="code-snippet" data-curl-snippet>
                <button
                  type="button"
                  class="button button--ghost copy--snippet"
                  data-copy-curl
                  aria-label="Copy curl command"
                >
                  Copy
                </button>
                <pre><code>$ curl http://nossl.sh</code></pre>
              </div>
            </div>
            <div>
              <h3>Honeypot dashboard</h3>
              <p class="muted">Review suspicious requests hitting the /.env honeypot endpoint.</p>
              <div class="code-snippet">
                <a class="button button--ghost copy--snippet" href="/honeypot">Open console</a>
              </div>
            </div>
          </div>
        </article>
      </section>

      <section class="card">
        <header class="card__header">
          <div>
            <p class="eyebrow">Why this page exists</p>
            <h2>How nossl.sh helps</h2>
          </div>
        </header>
        <div class="card__body">
          <p>
            Inspired by NeverSSL, nossl.sh is a quick diagnostic checkpoint when captive portals or restrictive firewalls block
            HTTPS handshakes. Load this page to trigger splash screens and inspect what your device sends.
          </p>
          <p>
            Still stuck? Confirm your Wi-Fi link, temporarily disable VPNs, or retry after clearing custom DNS profiles.
          </p>
          <div class="seo-links">
            <p class="muted">Explore scenario-specific guides:</p>
            <ul>
              <li><a href="/guides"><b>Browse all guides by category</b></a></li>
              <li><a href="/captive-portal">Captive portal detection and diagnostics</a></li>
              <li><a href="/wifi-login-page">Wi-Fi login page tester</a></li>
              <li><a href="/mobile-wifi">Mobile Wi-Fi captive portal troubleshooting</a></li>
              <li><a href="/marriott-wifi-login">Hotel Wi-Fi: Marriott walkthrough</a></li>
              <li><a href="/starbucks-wifi-login">Cafe Wi-Fi: Starbucks checklist</a></li>
            </ul>
          </div>
        </div>
      </section>

      <section class="card">
        <header class="card__header">
          <div>
            <p class="eyebrow">Support</p>
            <h2>Frequently Asked Questions</h2>
          </div>
        </header>
        <div class="card__body">
          <dl class="faq-list">
            <dt class="faq-list__question">Why won't the Wi-Fi login page load?</dt>
            <dd class="faq-list__answer">
              Captive portals sometimes block HTTPS, VPN tunnels, or custom DNS. Open <a href="http://nossl.sh">http://nossl.sh</a> in your browser without a VPN to let the network show its splash page, then sign in.
            </dd>
            <dt class="faq-list__question">What is the URL to force Wi-Fi login?</dt>
            <dd class="faq-list__answer">
              Use <a href="http://nossl.sh">http://nossl.sh</a>. It serves plain HTTP with no HSTS, which most venues use to trigger captive portal login flows.
            </dd>
            <dt class="faq-list__question">How do I connect to the Wi-Fi login page?</dt>
            <dd class="faq-list__answer">
              Turn off VPNs, open <a href="http://nossl.sh">http://nossl.sh</a> in a browser, and the captive portal should appear. If it does not, refresh, try a private window, or toggle Wi-Fi off and on.
            </dd>
          </dl>
        </div>
      </section>
    </main>

    <footer class="footer">
      <div class="container">
        <p>Rendered in <%= typeof generationTimeMs === 'number' ? generationTimeMs.toFixed(2) + ' ms' : 'N/A' %>. Total requests: <span class="mono"><%= totalRequests.toLocaleString('en-US') %></span></p>
        <p class="muted">Prefer JSON? Try the <a href="/api/request-info" rel="nofollow">request info API endpoint</a>.</p>
      </div>
    </footer>

    <script>
      const latencyEl = document.querySelector('[data-api-latency]');
      const headersCopyButton = document.querySelector('[data-copy-headers]');
      const curlCopyButton = document.querySelector('[data-copy-curl]');

      if (latencyEl) {
        const startedAt = performance.now();
        fetch('/api/request-info', { headers: { Accept: 'application/json' } })
          .then((response) => {
            const elapsed = Math.round(performance.now() - startedAt);
            latencyEl.textContent = `${elapsed} ms`;

            if (!response.ok) {
              throw new Error('Response not OK');
            }
          })
          .catch(() => {
            latencyEl.textContent = 'Unable to measure';
          });
      }

      const fallbackCopyText = (text) => {
        const textarea = document.createElement('textarea');
        textarea.value = text;
        textarea.setAttribute('readonly', '');
        textarea.style.position = 'absolute';
        textarea.style.left = '-9999px';
        document.body.appendChild(textarea);

        const selection = window.getSelection();
        if (selection && selection.rangeCount) {
          selection.removeAllRanges();
        }

        textarea.select();

        let successful = false;
        try {
          successful = document.execCommand('copy');
        } catch (error) {
          successful = false;
        }

        document.body.removeChild(textarea);
        return successful;
      };

      const copyText = async (text) => {
        if (navigator.clipboard && typeof navigator.clipboard.writeText === 'function') {
          try {
            await navigator.clipboard.writeText(text);
            return true;
          } catch (error) {
            // fall back to execCommand
          }
        }

        return fallbackCopyText(text);
      };

      const shareButton = document.querySelector('[data-share-report]');
      const shareStatus = document.querySelector('[data-share-status]');

      const setShareStatus = (text) => {
        if (!shareStatus) {
          return;
        }
        shareStatus.textContent = text;
      };

      if (shareButton) {
        const shareUrl = shareButton.getAttribute('data-share-url') || '';
        if (shareUrl) {
          setShareStatus(shareUrl);
        } else {
          shareButton.disabled = true;
        }

        const resetShareButton = () => {
          shareButton.textContent = 'Copy share link';
          shareButton.disabled = false;
        };

        shareButton.addEventListener('click', async () => {
          if (!shareUrl) {
            return;
          }
          shareButton.textContent = 'Copying…';
          shareButton.disabled = true;
          try {
            const copied = await copyText(shareUrl);
            shareButton.textContent = copied ? 'Link copied' : 'Copy failed';
            setShareStatus(shareUrl);
          } catch (error) {
            shareButton.textContent = 'Unavailable';
            setShareStatus('Sharing is temporarily unavailable.');
          } finally {
            setTimeout(resetShareButton, 2500);
          }
        });
      }

      if (headersCopyButton) {
        const headerPairs = <%- JSON.stringify(headers) %>;
        const headersPayload = headerPairs.reduce((acc, [key, value]) => {
          if (acc[key]) {
            acc[key] = Array.isArray(acc[key]) ? [...acc[key], value] : [acc[key], value];
          } else {
            acc[key] = value;
          }
          return acc;
        }, {});

        headersCopyButton.addEventListener('click', async () => {
          const copied = await copyText(JSON.stringify(headersPayload, null, 2));
          headersCopyButton.textContent = copied ? 'Copied!' : 'Copy failed';
          setTimeout(() => {
            headersCopyButton.textContent = 'Copy as JSON';
          }, 2000);
        });
      }

      if (curlCopyButton) {
        const curlCommand =  'curl http://nossl.sh';
        const resetLabel = () => {
          curlCopyButton.textContent = 'Copy';
        };

        curlCopyButton.addEventListener('click', async () => {
          const copied = await copyText(curlCommand);
          curlCopyButton.textContent = copied ? 'Copied!' : 'Copy failed';
          setTimeout(resetLabel, 2000);
        });
      }
    </script>
  </body>
</html>
