<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Shared Connection Report</title>
    <meta name="description" content="Plain-text shared connection report from nossl.sh." />
    <link rel="icon" href="/favicon.ico" type="image/svg+xml" />
    <link rel="stylesheet" href="/static/styles.css?v=2" />
  </head>
  <body>
    <% const formatTimestamp = (value) => { const dt = new Date(value); if (Number.isNaN(dt.getTime())) { return String(value ?? ''); } return dt.toISOString().replace('T', ' ').replace(/\..+/, ' UTC'); }; %>
    <header class="top-bar">
      <div class="container top-bar__row">
        <a class="brand" href="/" aria-label="nossl.sh home">
          <span class="brand-dot" aria-hidden="true"></span>
          <div class="brand-text">
            <span class="brand-name">nossl.sh</span>
            <span class="brand-status"><span class="status-dot" aria-hidden="true"></span> Online</span>
          </div>
        </a>
        <p class="top-bar__note">Shared connection report</p>
      </div>
    </header>

    <main class="container marketing">
      <article class="panel panel--connection">
          <% if (report) { %>
        <header class="panel__header">
          <div>
            <h1>Shared report:  <%= reportId  %>  </h1>
            <p class="panel__summary">A plain snapshot of one request served by nossl.sh</p>
          </div>
        </header><%}%>
        <div class="panel__body">
          <% if (!report) { %>
            <p>Report expired.</p>
          <% } else { %>
            <dl class="connection-grid connection-grid--compact">
              <div>
                <dt>Status</dt>
                <dd><%= report.status %></dd>
              </div>
              <div>
                <dt>Protocol</dt>
                <dd><%= (report.scheme || '').toUpperCase() %></dd>
              </div>
              <div>
                <dt>Client IP</dt>
                <dd><%= report.clientIp %></dd>
              </div>
              <div>
                <dt>Captured at</dt>
                <dd><%= formatTimestamp(report.generatedAt) %></dd>
              </div>
              <div>
                <dt>Render time</dt>
                <dd><%= typeof report.generationTimeMs === 'number' ? report.generationTimeMs.toFixed(2) + ' ms' : 'N/A' %></dd>
              </div>
            </dl>

            <div class="table-wrapper" style="margin-top: 1rem;">
              <table>
                <thead>
                  <tr>
                    <th scope="col">Header</th>
                    <th scope="col">Value</th>
                  </tr>
                </thead>
                <tbody>
                  <% (report.headers || []).forEach(function(header) { const key = header?.[0]; const value = header?.[1]; %>
                  <tr>
                    <th scope="row"><%= key %></th>
                    <td><%= value %></td>
                  </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          <% } %>
        </div>
      </article>
    </main>

    <footer class="footer">
      <div class="container footer__inner">
        <p>Page generated at <span class="mono"><%= generatedAt.toISOString().replace('T', ' ').replace(/\..+/, ' UTC') %></span> · Render time: <%= typeof generationTimeMs === 'number' ? generationTimeMs.toFixed(2) + ' ms' : 'N/A' %></p>
        <p>Return to the <a href="/">main nossl.sh page</a>.</p>
      </div>
    </footer>
  </body>
</html>
