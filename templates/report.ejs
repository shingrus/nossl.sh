<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Shared Connection Report</title>
    <meta name="description" content="Plain-text shared connection report from nossl.sh." />
    <link rel="icon" href="/favicon.ico" type="image/svg+xml" />
    <link rel="stylesheet" href="/static/styles.css?v=2" />
  </head>
  <body>
    <% 
      const headerPairs = report?.headers || [];
      const headerCount = headerPairs.length;
      // const schemeLabel = report?.scheme === 'https' ? 'HTTPS' : 'HTTP';
      // const httpLabel = (report?.httpVersion ? `HTTP/${report.httpVersion}` : 'HTTP/1.1') + ' · ' + schemeLabel;
      var httpLabel;
      if (report?.scheme === 'https')  {
          httpLabel = (report?.httpVersion ? `HTTPS/${report.httpVersion}` : 'HTTPS/1.1');
      } else
      {
          httpLabel = (report?.httpVersion ? `HTTP/${report.httpVersion}` : 'HTTP/1.1');
      }

      const mainIp = report?.clientIp || '';
      const isIpv6 = (value) => {
        if (!value) {
          return false;
        }
        const trimmed = String(value).trim().toLowerCase();
        if (!trimmed) {
          return false;
        }
        if (trimmed.startsWith('::ffff:')) {
          return false;
        }
        return trimmed.includes(':');
      };
      const mainIsIpv6 = isIpv6(mainIp);
      const primaryIpType = mainIsIpv6 ? 'v6' : 'v4';
      const secondaryIp = (mainIsIpv6 ? report?.clientIpv4 : report?.clientIpv6) || '';
      const secondaryLabel = mainIsIpv6 ? 'IPv4 address' : 'IPv6 address';
      const secondaryCopyLabel = `Copy ${secondaryLabel}`;
      const hasSecondaryIp = secondaryIp && secondaryIp.trim() && secondaryIp !== mainIp;
      const geo = report?.geo;
      const resolverIp = (report?.resolverIp || report?.resolver_ip || '').trim();
      const orgLink = geo?.asn ? `/as${geo.asn}` : null;
      const geoLocationLabel = geo?.countryName || geo?.cityName
        ? [geo?.countryName, geo?.cityName].filter(Boolean).join(' - ')
        : null;
      const geoSummary = geoLocationLabel ? [geo?.countryFlag, geoLocationLabel].filter(Boolean).join(' ') : null;
      const headerNote = 'Shared connection report';
      const footerLines = ['Return to the <a href=\"/\">main nossl.sh page</a>.'];
    %>
    <%- include('partials/header', {headerNote}) %>

    <main class="container page">
      <% if (!report) { %>
        <section class="card hero">
          <div class="card__header">
            <div>
              <p class="eyebrow">Shared snapshot</p>
              <h1 class="card__title">Shared report</h1>
              <p class="panel__summary">This report has expired.</p>
            </div>
          </div>
        </section>
      <% } else { %>
      <section class="card hero">
        <div class="card__header">
          <div>
            <p class="eyebrow">Shared snapshot</p>
            <h1 class="card__title">Shared connection report</h1>
            <p class="panel__summary">Captured request: <span class="mono"><%= reportId %></span></p>
          </div>

        </div>
        <div class="hero-grid">
          <div class="hero-primary" data-primary-ip-type="<%= primaryIpType %>">
            <p class="label">Client IP</p>
            <button type="button" class="ip-row ip-copy" data-copy-text="<%= report.clientIp %>" data-flash-mode="overlay">
              <span class="ip-address-value mono" data-primary-ip-value><%= report.clientIp %></span>
              <span class="ip-copy-icon" aria-hidden="true">⧉</span>
              <span class="sr-only">Copy IP address</span>
            </button>
            <% if (hasSecondaryIp) { %>
              <div class="ip6-block">
                <p class="label"><%= secondaryLabel %></p>
                <button type="button" class="ip-row ip-copy" data-copy-text="<%= secondaryIp %>" data-flash-mode="overlay">
                  <span class="ip-address-value mono" data-secondary-ip-value><%= secondaryIp %></span>
                  <span class="ip-copy-icon" aria-hidden="true">⧉</span>
                  <span class="sr-only"><%= secondaryCopyLabel %></span>
                </button>
              </div>
            <% } %>
            <% if (geoSummary)  { %>
              <p class="ip-location mono">
                <%= geoSummary %>
                <% if (geo?.orgName) { %>
                  /
                  <% if (orgLink) { %>
                    <a href="<%= orgLink %>"><%= geo.orgName %></a>
                  <% } else { %>
                    <%= geo.orgName %>
                  <% } %>
                <% } %>
              </p>
            <% } %>
          </div>
          <div class="hero-secondary">
            <dl class="meta-grid meta-grid--compact">
              <div>
                <dt>🗼 Your DNS Resolver</dt>
                <dd class="ip6-value mono">
                  <% if (resolverIp) { %>
                    <a href="/free-geo-ip?<%= encodeURIComponent(resolverIp) %>" rel="nofollow"><%= resolverIp %></a>
                  <% } else { %>
                    ...
                  <% } %>
                </dd>
              </div>
              <div>
                <dt>🌐 Protocol</dt>
                <dd class="mono"><%= httpLabel %></dd>
              </div>
              <div>
                <dt>🕒 Captured</dt>
                <dd><%= formatTimestamp(report.generatedAt) %></dd>
              </div>
              <div>
                <dt>🧾 Headers captured</dt>
                <dd><%= headerCount %></dd>
              </div>
            </dl>
          </div>
        </div>
      </section>

      <section aria-labelledby="shared-headers" class="card collapsible">
        <div class="card__header card__header--toggle card__header_clickable">
          <div>
            <p class="eyebrow">Headers</p>
            <h2 id="shared-headers" class="card__title">Request headers</h2>
          </div>
          <div class="header-actions">
            <span class="pill pill-muted"><%= headerCount %> headers</span>
            <button
              type="button"
              class="btn btn-outline toggle"
              data-toggle-headers
              aria-expanded="false"
              data-expanded="false"
              aria-controls="headers-content"
            >
              <span data-toggle-label>Show</span>
              <span class="chevron" aria-hidden="true"></span>
            </button>
            <button type="button" class="btn btn-ghost" data-copy-headers>Copy JSON</button>
          </div>
        </div>
        <div class="collapsible__content" id="headers-content" hidden>
          <div class="table-wrapper headers-table-wrapper">
            <table class="headers-table">
              <thead>
                <tr>
                  <th scope="col">Header</th>
                  <th scope="col">Value</th>
                </tr>
              </thead>
              <tbody>
                <% headerPairs.forEach(([key, value]) => { %>
                <tr>
                  <th scope="row"><span class="mono"><%= key %></span></th>
                  <td><span class="mono"><%= value %></span></td>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      </section>
              <%- include('partials/support-block') %>
      <% } %>
    </main>

    <%- include('partials/footer', {generationTimeMs, footerLines, generatedAt}) %>

    <script>
      (() => {
        const headersCopyButton = document.querySelector('[data-copy-headers]');
        const headersToggleButton = document.querySelector('[data-toggle-headers]');

        const fallbackCopyText = (text) => {
          const textarea = document.createElement('textarea');
          textarea.value = text;
          textarea.setAttribute('readonly', '');
          textarea.style.position = 'absolute';
          textarea.style.left = '-9999px';
          document.body.appendChild(textarea);
          textarea.select();
          let successful;
          try {
            successful = document.execCommand('copy');
          } catch (error) {
            successful = false;
          }
          document.body.removeChild(textarea);
          return successful;
        };

        const copyText = async (text) => {
          if (!text) return false;
          if (navigator.clipboard && typeof navigator.clipboard.writeText === 'function') {
            try {
              await navigator.clipboard.writeText(text);
              return true;
            } catch (error) {
              // fallback below
            }
          }
          return fallbackCopyText(text);
        };

        const flashButton = (button, label) => {
          if (!button) return;
          const useOverlay = button.dataset.flashMode === 'overlay';
          if (useOverlay) {
            button.dataset.flashLabel = label;
            button.classList.add('is-flashing');
            button.disabled = true;
            setTimeout(() => {
              button.classList.remove('is-flashing');
              button.dataset.flashLabel = '';
              button.disabled = false;
            }, 1800);
            return;
          }
          const original = button.textContent.trim();
          button.textContent = label;
          button.disabled = true;
          setTimeout(() => {
            button.textContent = original;
            button.disabled = false;
          }, 2000);
        };

        document.querySelectorAll('[data-copy-text]').forEach((button) => {
          button.addEventListener('click', async () => {
            const text = button.getAttribute('data-copy-text');
            const copied = await copyText(text);
            flashButton(button, copied ? 'Copied' : 'Copy failed');
          });
        });

        if (headersToggleButton) {
          const targetId = headersToggleButton.getAttribute('aria-controls');
          const content = document.getElementById(targetId);
          const labelEl = headersToggleButton.querySelector('[data-toggle-label]');

          const setState = (expanded) => {
            headersToggleButton.setAttribute('aria-expanded', String(expanded));
            headersToggleButton.dataset.expanded = String(expanded);
            if (content) {
              content.hidden = !expanded;
            }
            if (labelEl) {
              labelEl.textContent = expanded ? 'Hide' : 'Show';
            }
          };

          setState(false);

          headersToggleButton.addEventListener('click', () => {
            const isExpanded = headersToggleButton.getAttribute('aria-expanded') === 'true';
            setState(!isExpanded);
          });
        }

        if (headersCopyButton) {
          const headerPairs = <%- JSON.stringify(headerPairs) %>;
          const headersPayload = headerPairs.reduce((acc, [key, value]) => {
            if (acc[key]) {
              acc[key] = Array.isArray(acc[key]) ? [...acc[key], value] : [acc[key], value];
            } else {
              acc[key] = value;
            }
            return acc;
          }, {});

          headersCopyButton.addEventListener('click', async () => {
            const copied = await copyText(JSON.stringify(headersPayload, null, 2));
            flashButton(headersCopyButton, copied ? 'Copied' : 'Copy failed');
          });
        }

        document.querySelectorAll('.card__header_clickable').forEach((header) => {
          header.addEventListener('click', (event) => {
            if (event.target.closest('a, button')) {
              return;
            }
            const toggleButton = header.querySelector('[data-toggle-headers]');
            if (toggleButton) {
              toggleButton.click();
            }
          });
        });
      })();
    </script>
  </body>
</html>
