<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Shared Connection Report</title>
    <meta name="description" content="Plain-text shared connection report from nossl.sh." />
    <link rel="icon" href="/favicon.ico" type="image/svg+xml" />
    <link rel="stylesheet" href="/static/styles.css?v=2" />
  </head>
  <body>
    <% 
      const formatTimestamp = (value) => { const dt = new Date(value); if (Number.isNaN(dt.getTime())) { return String(value ?? ''); } return dt.toISOString().replace('T', ' ').replace(/\..+/, ' UTC'); }; 
      const headerPairs = report?.headers || [];
      const headerCount = headerPairs.length;
      const schemeLabel = report?.scheme === 'https' ? 'HTTPS (TLS)' : 'HTTP (no TLS)';
      const httpLabel = (report?.httpVersion ? `HTTP/${report.httpVersion}` : 'HTTP/1.1') + ' · ' + schemeLabel;
      const formattedGeneratedAt = formatTimestamp(generatedAt);
      const headerNote = 'Shared connection report';
      const footerLines = ['Return to the <a href=\"/\">main nossl.sh page</a>.'];
    %>
    <%- include('partials/header', {headerNote}) %>

    <main class="container page">
      <% if (!report) { %>
        <section class="card hero">
          <div class="card__header">
            <div>
              <p class="eyebrow">Shared snapshot</p>
              <h1 class="card__title">Shared report</h1>
              <p class="panel__summary">This report has expired.</p>
            </div>
          </div>
        </section>
      <% } else { %>
      <section class="card hero">
        <div class="card__header">
          <div>
            <p class="eyebrow">Shared snapshot</p>
            <h1 class="card__title">Shared connection report</h1>
            <p class="panel__summary">Captured request: <span class="mono"><%= reportId %></span></p>
          </div>

        </div>
        <div class="hero-grid">
          <div class="hero-primary">
            <p class="label">Client IP</p>
            <div class="ip-row">
              <span class="ip-value mono"><%= report.clientIp %></span>
              <button type="button" class="btn btn-ghost" data-copy-text="<%= report.clientIp %>">Copy</button>
            </div>
            <dl class="meta-grid meta-grid--compact hero-meta">
              <div>
                <dt>🌐 Protocol</dt>
                <dd class="mono"><%= httpLabel %></dd>
              </div>
            </dl>
          </div>
          <div class="hero-secondary">
            <dl class="meta-grid meta-grid--compact">
              <div>
                <dt>🕒 Captured</dt>
                <dd><%= formatTimestamp(report.generatedAt) %></dd>
              </div>
              <div>
                <dt>🧾 Headers captured</dt>
                <dd><%= headerCount %></dd>
              </div>
              <div>
                <dt>📄 Status</dt>
                <dd><%= report.status %></dd>
              </div>
            </dl>
          </div>
        </div>
      </section>

      <section aria-labelledby="shared-headers" class="card collapsible">
        <div class="card__header card__header--toggle">
          <div>
            <p class="eyebrow">Headers</p>
            <h2 id="shared-headers" class="card__title">Request headers</h2>
          </div>
          <div class="header-actions">
            <span class="pill pill-muted"><%= headerCount %> headers</span>
            <button type="button" class="btn btn-ghost" data-copy-headers>Copy JSON</button>
          </div>
        </div>
        <div class="collapsible__content" id="headers-content">
          <div class="table-wrapper headers-table-wrapper">
            <table class="headers-table">
              <thead>
                <tr>
                  <th scope="col">Header</th>
                  <th scope="col">Value</th>
                </tr>
              </thead>
              <tbody>
                <% headerPairs.forEach(([key, value]) => { %>
                <tr>
                  <th scope="row"><span class="mono"><%= key %></span></th>
                  <td><span class="mono"><%= value %></span></td>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      </section>
      <% } %>
    </main>

    <%- include('partials/footer', {formattedGeneratedAt, generationTimeMs, footerLines, generatedAt}) %>

    <script>
      (() => {
        const headersCopyButton = document.querySelector('[data-copy-headers]');

        const fallbackCopyText = (text) => {
          const textarea = document.createElement('textarea');
          textarea.value = text;
          textarea.setAttribute('readonly', '');
          textarea.style.position = 'absolute';
          textarea.style.left = '-9999px';
          document.body.appendChild(textarea);
          textarea.select();
          let successful;
          try {
            successful = document.execCommand('copy');
          } catch (error) {
            successful = false;
          }
          document.body.removeChild(textarea);
          return successful;
        };

        const copyText = async (text) => {
          if (!text) return false;
          if (navigator.clipboard && typeof navigator.clipboard.writeText === 'function') {
            try {
              await navigator.clipboard.writeText(text);
              return true;
            } catch (error) {
              // fallback below
            }
          }
          return fallbackCopyText(text);
        };

        const flashButton = (button, label) => {
          if (!button) return;
          const original = button.textContent.trim();
          button.textContent = label;
          button.disabled = true;
          setTimeout(() => {
            button.textContent = original;
            button.disabled = false;
          }, 2000);
        };

        document.querySelectorAll('[data-copy-text]').forEach((button) => {
          button.addEventListener('click', async () => {
            const text = button.getAttribute('data-copy-text');
            const copied = await copyText(text);
            flashButton(button, copied ? 'Copied' : 'Copy failed');
          });
        });

        if (headersCopyButton) {
          const headerPairs = <%- JSON.stringify(headerPairs) %>;
          const headersPayload = headerPairs.reduce((acc, [key, value]) => {
            if (acc[key]) {
              acc[key] = Array.isArray(acc[key]) ? [...acc[key], value] : [acc[key], value];
            } else {
              acc[key] = value;
            }
            return acc;
          }, {});

          headersCopyButton.addEventListener('click', async () => {
            const copied = await copyText(JSON.stringify(headersPayload, null, 2));
            flashButton(headersCopyButton, copied ? 'Copied' : 'Copy failed');
          });
        }

      })();
    </script>
  </body>
</html>
