<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Free Geo + ASN MMDB databases | nossl.sh</title>
    <meta name="description" content="Free Geo IP + ASN MMDB databases for IPv4 and IPv6 lookups. Direct downloads with usage examples and live sample data." />
    <link rel="canonical" href="http://nossl.sh/free-geo-ip-database" />
    <meta property="og:title" content="Free Geo + ASN MMDB databases | nossl.sh" />
    <meta property="og:description" content="Free Geo IP + ASN MMDB databases for IPv4 and IPv6 lookups. Direct downloads with usage examples and live sample data." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="http://nossl.sh/free-geo-ip-database" />
    <meta property="og:site_name" content="nossl.sh" />
    <meta property="og:image" content="/static/og-image.png" />
    <meta property="og:image:alt" content="Abstract teal and navy banner for nossl.sh" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Free Geo + ASN MMDB databases | nossl.sh" />
    <meta name="twitter:description" content="Free Geo IP + ASN MMDB databases for IPv4 and IPv6 lookups. Direct downloads with usage examples and live sample data." />
    <meta name="twitter:image" content="/static/og-image.png" />
    <meta name="twitter:image:alt" content="Abstract teal and navy banner for nossl.sh" />
    <link rel="icon" href="/favicon.ico" type="image/svg+xml" />
    <link rel="stylesheet" href="/static/styles.css?v=2" />
  </head>
  <body>
    <%
      const headerNote = 'Free Geo + ASN MMDB downloads';
      const footerLines = [
        'Want a live lookup? Visit <a href="/free-geo-ip" rel="nofollow">/free-geo-ip</a> or call <a href="/api/ip" rel="nofollow">/api/ip</a>.'
      ];
      const exampleIp = (clientIp || '').trim();
      const exampleGeo = geo || null;
      const hasExampleIp = Boolean(exampleIp);
      const apiExampleIp = hasExampleIp ? exampleIp : '1.1.1.1';
      const apiExampleQuery = apiExampleIp ? `?${encodeURIComponent(apiExampleIp)}` : '';
      const exampleResponse = exampleGeo
        ? {ip: exampleIp, ...exampleGeo}
        : {error: 'not_found', ip: exampleIp || null};
    %>
    <%- include('partials/header', {headerNote}) %>

    <main class="container dashboard">
      <section class="panel">
        <header class="panel__header">
          <div>
            <p class="eyebrow">Free download</p>
            <h1>Free Geo + ASN MMDB databases</h1>
            <p class="panel__summary">Free MaxMind DB (mmdb) files for IP-to-Geo and IP-to-ASN lookups. It's free for use.</p>
          </div>
          <p class="panel__summary">MIT license. No sign-up. No rate limits.</p>
        </header>
      </section>

      <section class="panel">
        <header class="panel__header">
          <div>
            <h2 class="download-title">Downloads</h2>
            <p class="muted">Updated Feb 1 (updates weekly).</p>
          </div>
          <div>
            <a class="btn btn-outline" href="https://buymeacoffee.com/nossl" rel="nofollow">Support the project</a>
          </div>
        </header>
        <div class="panel__body info-grid">
          <article class="info-card">
            <h3 class="card__title">Geo IP database</h3>
            <p class="muted">Country + city metadata for public IPs. Use this for location and country code lookups.</p>
            <p class="muted">
              <a href="https://github.com/shingrus/nossl.sh/raw/refs/heads/main/mmdbs/ip2geo-nossl-sh.mmdb" class="download-link">
                <span class="download-link__icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" role="img" focusable="false">
                    <path d="M12 3v10m0 0l-4-4m4 4l4-4M5 17h14v3H5z" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </span>
                <span class="download-link__text mono"><%= geoMmdbFilename %></span>
              </a>
            </p>
            <p class="muted">Supports IPv4 + IPv6.</p>
          </article>

          <article class="info-card">
            <h3 class="card__title">ASN database</h3>
            <p class="muted">ASN number + organization name for public IPs. Use this for network ownership and ASN lookups.</p>
            <p class="muted">
              <a href="https://github.com/shingrus/nossl.sh/raw/refs/heads/main/mmdbs/ip2asn-nossl-sh.mmdb" class="download-link">
                <span class="download-link__icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" role="img" focusable="false">
                    <path d="M12 3v10m0 0l-4-4m4 4l4-4M5 17h14v3H5z" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </span>
                <span class="download-link__text mono"><%= asnMmdbFilename %></span>
              </a>
            </p>
            <p class="muted">Supports IPv4 + IPv6.</p>
          </article>
        </div>
      </section>

      <section class="panel">
        <header class="panel__header">
          <div>
            <p class="eyebrow">Usage</p>
            <h2>Code examples</h2>
            <p class="panel__summary">Pick your language and load the MMDB file with the MaxMind DB reader for that ecosystem.</p>
          </div>
        </header>
        <div class="panel__body">
          <div class="code-tabs" role="tablist" aria-label="MMDB code samples" data-code-tablist data-code-group="mmdb" data-default="js">
            <button type="button" class="code-tab is-active" role="tab" data-code-tab="js" data-code-group="mmdb" aria-controls="code-panel-mmdb-js" aria-selected="true" tabindex="0">JavaScript</button>
            <button type="button" class="code-tab" role="tab" data-code-tab="python" data-code-group="mmdb" aria-controls="code-panel-mmdb-python">Python</button>
            <button type="button" class="code-tab" role="tab" data-code-tab="go" data-code-group="mmdb" aria-controls="code-panel-mmdb-go">Go</button>
            <button type="button" class="code-tab" role="tab" data-code-tab="rust" data-code-group="mmdb" aria-controls="code-panel-mmdb-rust">Rust</button>
            <button type="button" class="code-tab" role="tab" data-code-tab="java" data-code-group="mmdb" aria-controls="code-panel-mmdb-java">Java</button>
            <button type="button" class="code-tab" role="tab" data-code-tab="php" data-code-group="mmdb" aria-controls="code-panel-mmdb-php">PHP</button>
          </div>

          <div class="code-block" role="tabpanel" id="code-panel-mmdb-js" data-code-sample="js" data-code-group="mmdb">
            <code class="mono">import maxmind from 'maxmind';

const reader = await maxmind.open('ip2geo-nossl-sh.mmdb');
const record = reader.get('<%= apiExampleIp %>');
console.log(record);
// swap file name to ip2asn-nossl-sh.mmdb for ASN data</code>
            <button type="button" class="btn btn-outline btn-small" data-copy-text="import maxmind from 'maxmind';\n\nconst reader = await maxmind.open('ip2geo-nossl-sh.mmdb');\nconst record = reader.get('<%= apiExampleIp %>');\nconsole.log(record);\n// swap file name to ip2asn-nossl-sh.mmdb for ASN data">Copy</button>
          </div>

          <div class="code-block" role="tabpanel" id="code-panel-mmdb-python" data-code-sample="python" data-code-group="mmdb" hidden>
            <code class="mono">import maxminddb

reader = maxminddb.open_database('ip2geo-nossl-sh.mmdb')
record = reader.get('<%= apiExampleIp %>')
print(record)
# swap file name to ip2asn-nossl-sh.mmdb for ASN data</code>
            <button type="button" class="btn btn-outline btn-small" data-copy-text="import maxminddb\n\nreader = maxminddb.open_database('ip2geo-nossl-sh.mmdb')\nrecord = reader.get('<%= apiExampleIp %>')\nprint(record)\n# swap file name to ip2asn-nossl-sh.mmdb for ASN data">Copy</button>
          </div>

          <div class="code-block" role="tabpanel" id="code-panel-mmdb-go" data-code-sample="go" data-code-group="mmdb" hidden>
            <code class="mono">import (
  "fmt"
  "net"
  "github.com/oschwald/maxminddb-golang"
)

db, _ := maxminddb.Open("ip2geo-nossl-sh.mmdb")
defer db.Close()

var record map[string]interface{}
db.Lookup(net.ParseIP("<%= apiExampleIp %>"), &record)
fmt.Printf("%v\n", record)
// swap file name to ip2asn-nossl-sh.mmdb for ASN data</code>
            <button type="button" class="btn btn-outline btn-small" data-copy-text="import (\n  &quot;fmt&quot;\n  &quot;net&quot;\n  &quot;github.com/oschwald/maxminddb-golang&quot;\n)\n\ndb, _ := maxminddb.Open(&quot;ip2geo-nossl-sh.mmdb&quot;)\ndefer db.Close()\n\nvar record map[string]interface{}\ndb.Lookup(net.ParseIP(&quot;<%= apiExampleIp %>&quot;), &record)\nfmt.Printf(&quot;%v\\n&quot;, record)\n// swap file name to ip2asn-nossl-sh.mmdb for ASN data">Copy</button>
          </div>

          <div class="code-block" role="tabpanel" id="code-panel-mmdb-rust" data-code-sample="rust" data-code-group="mmdb" hidden>
            <code class="mono">use maxminddb::Reader;
use std::net::IpAddr;

let reader = Reader::open_readfile("ip2geo-nossl-sh.mmdb").unwrap();
let ip: IpAddr = "<%= apiExampleIp %>".parse().unwrap();
let record: serde_json::Value = reader.lookup(ip).unwrap();
println!("{}", record);
// swap file name to ip2asn-nossl-sh.mmdb for ASN data</code>
            <button type="button" class="btn btn-outline btn-small" data-copy-text="use maxminddb::Reader;\nuse std::net::IpAddr;\n\nlet reader = Reader::open_readfile(&quot;ip2geo-nossl-sh.mmdb&quot;).unwrap();\nlet ip: IpAddr = &quot;<%= apiExampleIp %>&quot;.parse().unwrap();\nlet record: serde_json::Value = reader.lookup(ip).unwrap();\nprintln!(&quot;{}&quot;, record);\n// swap file name to ip2asn-nossl-sh.mmdb for ASN data">Copy</button>
          </div>

          <div class="code-block" role="tabpanel" id="code-panel-mmdb-java" data-code-sample="java" data-code-group="mmdb" hidden>
            <code class="mono">import com.maxmind.db.Reader;
import java.io.File;
import java.net.InetAddress;
import java.util.Map;

Reader reader = new Reader(new File("ip2geo-nossl-sh.mmdb"));
InetAddress ip = InetAddress.getByName("<%= apiExampleIp %>");
Map&lt;String, Object&gt; record = reader.get(ip);
System.out.println(record);
// swap file name to ip2asn-nossl-sh.mmdb for ASN data</code>
            <button type="button" class="btn btn-outline btn-small" data-copy-text="import com.maxmind.db.Reader;\nimport java.io.File;\nimport java.net.InetAddress;\nimport java.util.Map;\n\nReader reader = new Reader(new File(&quot;ip2geo-nossl-sh.mmdb&quot;));\nInetAddress ip = InetAddress.getByName(&quot;<%= apiExampleIp %>&quot;);\nMap<String, Object> record = reader.get(ip);\nSystem.out.println(record);\n// swap file name to ip2asn-nossl-sh.mmdb for ASN data">Copy</button>
          </div>

          <div class="code-block" role="tabpanel" id="code-panel-mmdb-php" data-code-sample="php" data-code-group="mmdb" hidden>
            <code class="mono">&lt;?php
use MaxMind\Db\Reader;

$reader = new Reader('ip2geo-nossl-sh.mmdb');
$record = $reader-&gt;get('<%= apiExampleIp %>');
print_r($record);
// swap file name to ip2asn-nossl-sh.mmdb for ASN data</code>
            <button type="button" class="btn btn-outline btn-small" data-copy-text="<?php\nuse MaxMind\\Db\\Reader;\n\n$reader = new Reader('ip2geo-nossl-sh.mmdb');\n$record = $reader->get('<%= apiExampleIp %>');\nprint_r($record);\n// swap file name to ip2asn-nossl-sh.mmdb for ASN data">Copy</button>
          </div>
        </div>
      </section>

      <section class="panel">
        <header class="panel__header">
          <div>
            <p class="eyebrow">Example data</p>
            <h2>Live data for your IP</h2>
            <p class="panel__summary">Example response pulled from the current request IP.</p>
          </div>
        </header>
        <div class="panel__body">
          <% if (!hasExampleIp) { %>
            <p class="muted">No client IP detected for this request.</p>
          <% } else { %>
            <% if (!exampleGeo) { %>
              <p class="muted">No Geo/ASN data found for <span class="mono"><%= exampleIp %></span>. Private or reserved IPs are expected to return 404.</p>
            <% } %>
            <div class="code-snippet">
              <pre><%= JSON.stringify(exampleResponse, null, 2) %></pre>
            </div>
            <div class="code-block" style="margin-top: 12px;">
              <code class="mono">$ curl 'http://nossl.sh/api/ip<%= apiExampleQuery %>'</code>
              <button type="button" class="btn btn-outline btn-small" data-copy-text="curl 'http://nossl.sh/api/ip<%= apiExampleQuery %>'">Copy</button>
            </div>
          <% } %>
        </div>
      </section>

      <section class="panel">
        <header class="panel__header">
          <div>
            <p class="eyebrow">License</p>
            <h2>MIT, free for any use</h2>
            <p class="panel__summary">These files are provided under the MIT License - free to use, modify, and redistribute, including commercial use.</p>
          </div>
        </header>
      </section>

      <%- include('partials/support-block') %>
    </main>

    <script>
      (() => {
        const fallbackCopyText = (text) => {
          const textarea = document.createElement('textarea');
          textarea.value = text;
          textarea.setAttribute('readonly', '');
          textarea.style.position = 'absolute';
          textarea.style.left = '-9999px';
          document.body.appendChild(textarea);
          textarea.select();

          let successful;
          try {
            successful = document.execCommand('copy');
          } catch (error) {
            successful = false;
          }

          document.body.removeChild(textarea);
          return successful;
        };

        const copyText = async (text) => {
          if (!text) {
            return false;
          }
          if (navigator.clipboard && typeof navigator.clipboard.writeText === 'function') {
            try {
              await navigator.clipboard.writeText(text);
              return true;
            } catch (error) {
              // fall back to execCommand
            }
          }
          return fallbackCopyText(text);
        };

        const flashButton = (button, label) => {
          if (!button) return;
          const originalLabel = button.textContent.trim();
          button.textContent = label;
          button.disabled = true;
          setTimeout(() => {
            button.textContent = originalLabel;
            button.disabled = false;
          }, 2000);
        };

        document.querySelectorAll('[data-copy-text]').forEach((button) => {
          button.addEventListener('click', async () => {
            const text = button.getAttribute('data-copy-text');
            const copied = await copyText(text);
            flashButton(button, copied ? 'Copied' : 'Copy failed');
          });
        });

        const setActiveCodeTab = (group, tab) => {
          const buttons = document.querySelectorAll(`[data-code-group="${group}"][data-code-tab]`);
          const samples = document.querySelectorAll(`[data-code-group="${group}"][data-code-sample]`);
          buttons.forEach((button) => {
            const isActive = button.getAttribute('data-code-tab') === tab;
            button.classList.toggle('is-active', isActive);
            button.setAttribute('aria-selected', isActive ? 'true' : 'false');
            button.setAttribute('tabindex', isActive ? '0' : '-1');
          });
          samples.forEach((sample) => {
            const isActive = sample.getAttribute('data-code-sample') === tab;
            sample.hidden = !isActive;
          });
        };

        document.querySelectorAll('[data-code-tablist]').forEach((tablist) => {
          const group = tablist.getAttribute('data-code-group');
          const defaultTab = tablist.getAttribute('data-default');
          const firstButton = tablist.querySelector('[data-code-tab]');
          const initialTab = defaultTab || (firstButton ? firstButton.getAttribute('data-code-tab') : null);

          if (group && initialTab) {
            setActiveCodeTab(group, initialTab);
          }

          tablist.querySelectorAll('[data-code-tab]').forEach((button) => {
            button.addEventListener('click', () => {
              const nextTab = button.getAttribute('data-code-tab');
              if (group && nextTab) {
                setActiveCodeTab(group, nextTab);
              }
            });
          });
        });
      })();
    </script>

    <%- include('partials/footer', {generationTimeMs, footerLines, generatedAt}) %>
  </body>
</html>
