<%
  const footerTimestamp = typeof formattedGeneratedAt === 'string' && formattedGeneratedAt.length
    ? formattedGeneratedAt
    : formatTimestamp(generatedAt);
  const footerRenderTime = typeof generationTimeMs === 'number' ? `${generationTimeMs.toFixed(2)} ms` : 'N/A';
  const extraLines = Array.isArray(footerLines) ? footerLines : [];
%>
<footer class="footer">
  <div class="container footer__inner">
    <p>Page generated at <span class="mono"><%= footerTimestamp %></span> · Render time: <%= footerRenderTime %></p>
    <% extraLines.forEach((line) => { %>
      <p><%- line %></p>
    <% }) %>
  </div>
</footer>
