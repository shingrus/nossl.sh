<%
  const connectionReport = (() => {
    const headerPairs = Array.isArray(headers) ? headers : [];
    const headerCount = headerPairs.length;
    // const schemeLabel = scheme === 'https' ? '(TLS)' : '(no TLS)';
    const httpLabel = (httpVersion ? `HTTP/${httpVersion}` : 'HTTP/1.1');// + '·' + schemeLabel;
    const formattedGeneratedAt = formatTimestamp(generatedAt);
    let geoSummary = null;
    if (geo?.countryName || geo?.cityName) {
        const locationLabel = [geo?.countryName, geo?.cityName].filter(Boolean).join(' - ');
        geoSummary = [geo?.countryFlag, locationLabel].filter(Boolean).join(' ');
    }
    const orgLink = geo?.asn ? `/as${geo.asn}` : null;

    return {
      formattedGeneratedAt,
      geoSummary,
      headerCount,
      headerPairs,
      httpLabel,
      orgLink
    };
  })();
%>

<section aria-labelledby="connection-report" class="card hero">
  <div class="card__header">
    <div>
      <div class="card__title-row">
        <h1 id="connection-report" class="card__title">Connection report</h1>
        <% if (shareReportEnabled) { %>
          <button type="button" class="btn btn-outline" data-share-report data-share-url="<%= shareReportUrl %>">
            <svg class="btn-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M12 3l4 4m-4-4l-4 4m4-4v10" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
              <path d="M5 12v7a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
            <span data-share-label>Share</span>
          </button>
        <% } %>
      </div>
    </div>
    <div class="card__actions">
      <a href="https://buymeacoffee.com/nossl" rel="nofollow">
        <span class="btn btn-outline">Support the project</span>
      </a>
    </div>
  </div>
  <div class="hero-grid">
    <div class="hero-primary">
      <p class="label">IP address</p>
      <button type="button" class="ip-row ip-copy ip-row--inline" data-copy-text="<%= clientIp %>" data-flash-mode="overlay">
        <span class="ip-value mono"><%= clientIp %></span>
        <span class="ip-copy-icon" aria-hidden="true">⧉</span>
        <span class="sr-only">Copy IP address</span>
      </button>
      <div class="ip6-block" data-ipv6-row hidden>
        <p class="label">IPv6 address</p>
        <button type="button" class="ip-row ip-copy" data-copy-text="" data-flash-mode="overlay">
          <span class="ip6-value mono" data-ipv6-value></span>
          <span class="ip-copy-icon" aria-hidden="true">⧉</span>
          <span class="sr-only">Copy IPv6 address</span>
        </button>
      </div>
      <div class="ip6-block" data-ipv6-row hidden>
        <p class="label">IPv6 address</p>
        <div class="ip-row">
          <span class="ip-value mono" data-ipv6-value></span>
          <button type="button" class="btn btn-ghost" data-copy-text="">Copy</button>
        </div>
      </div>

      <% if (connectionReport.geoSummary) { %>
        <p class="ip-location mono">
          <%= connectionReport.geoSummary %>
          <% if (geo?.orgName) { %>
            /
            <% if (connectionReport.orgLink) { %>
              <a href="<%= connectionReport.orgLink %>"><%= geo.orgName %></a>
            <% } else { %>
              <%= geo.orgName %>
            <% } %>
          <% } %>
        </p>
        <a class="geo-link" href="/free-geo-ip" rel="nofollow">
          <span class="geo-link__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true">
              <path d="M12 4a8 8 0 1 0 0 16a8 8 0 0 0 0-16Z" fill="none" stroke="currentColor" stroke-width="1.8"></path>
              <path d="M4 12h16M12 4c2.5 3 2.5 13 0 16M12 4c-2.5 3-2.5 13 0 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"></path>
            </svg>
          </span>
          <span>Free Geo + ASN lookup</span>
        </a>
      <% } %>
    </div>
    <div class="hero-secondary">
      <dl class="meta-grid meta-grid--compact">
          <div>
              <dt>🗼 Your DNS Resolver</dt>
              <dd><span class="ip6-value mono" data-beacon-resolver>...</span></dd>
          </div>
          <div>
            <dt>🌐 Protocol</dt>
            <dd class="mono"><%= connectionReport.httpLabel %></dd>
        </div>
          <div>
            <dt>📡 Ping</dt>
            <dd class="mono" data-api-latency aria-live="polite">Measuring…</dd>
        </div>
          <div>
            <dt>🧾 Headers captured</dt>
            <dd><%= connectionReport.headerCount %></dd>
        </div>
        <div>
          <dt>🕒 Generated</dt>
          <dd><%= connectionReport.formattedGeneratedAt %></dd>
        </div>
      </dl>
    </div>
  </div>
</section>

<section aria-labelledby="request-headers" class="card collapsible">
  <div class="card__header card__header--toggle card__header_clickable">
    <div>
      <p class="eyebrow">Headers</p>
      <h2 id="request-headers" class="card__title">Request headers</h2>
    </div>
    <div class="header-actions">
      <span class="pill pill-muted"><%= connectionReport.headerCount %> headers</span>
      <button
        type="button"
        class="btn btn-outline toggle"
        data-toggle-headers
        aria-expanded="false"
        data-expanded="false"
        aria-controls="headers-content"
      >
        <span data-toggle-label>Show</span>
        <span class="chevron" aria-hidden="true"></span>
      </button>
      <button type="button" class="btn btn-ghost" data-copy-headers>Copy JSON</button>
    </div>
  </div>
  <div class="collapsible__content" id="headers-content" hidden>
    <div class="table-wrapper headers-table-wrapper">
      <table class="headers-table">
        <thead>
          <tr>
            <th scope="col">Header</th>
            <th scope="col">Value</th>
          </tr>
        </thead>
        <tbody>
          <% connectionReport.headerPairs.forEach(([key, value]) => { %>
            <tr>
              <th scope="row"><span class="mono"><%= key %></span></th>
              <td><span class="mono"><%= value %></span></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</section>
