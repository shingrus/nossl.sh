<script>
  (() => {
    const latencyEl = document.querySelector('[data-api-latency]');
    const headersCopyButton = document.querySelector('[data-copy-headers]');
    const headersToggleButton = document.querySelector('[data-toggle-headers]');
    const shareButton = document.querySelector('[data-share-report]');
    const secondaryBlocks = Array.from(document.querySelectorAll('[data-secondary-ip-row]'));
    const secondaryValueEls = Array.from(document.querySelectorAll('[data-secondary-ip-value]'));
    const secondaryCopyButtons = secondaryBlocks.flatMap((block) =>
      Array.from(block.querySelectorAll('[data-copy-text]'))
    );
    const secondaryLabelEls = Array.from(document.querySelectorAll('[data-secondary-ip-label]'));
    const secondarySrEls = Array.from(document.querySelectorAll('[data-secondary-ip-sr]'));
    const beaconResolverEl = document.querySelector('[data-beacon-resolver]');
    const beaconResolverMetaEl = document.querySelector('[data-beacon-resolver-org-name]');
    const mainIp = (<%- JSON.stringify(clientIp || '') %>).trim();
    const shareReportId = <%- JSON.stringify(shareReportId || null) %>;
    const beaconHostSuffix = '.r.nossl.sh';
    const isDev = <%- JSON.stringify(Boolean(isDev)) %>;

    const isIpv6 = (value) => {
      if (!value) {
        return false;
      }
      const trimmed = value.trim().toLowerCase();
      if (!trimmed) {
        return false;
      }
      if (trimmed.startsWith('::ffff:')) {
        return false;
      }
      return trimmed.includes(':');
    };

    const isMainIpv6 = isIpv6(mainIp);
    const secondaryLabel = isMainIpv6 ? 'IPv4 address' : 'IPv6 address';
    const secondaryCopyLabel = isMainIpv6 ? 'Copy IPv4 address' : 'Copy IPv6 address';

    secondaryLabelEls.forEach((label) => {
      label.textContent = secondaryLabel;
    });
    secondarySrEls.forEach((label) => {
      label.textContent = secondaryCopyLabel;
    });

    const fallbackCopyText = (text) => {
      const textarea = document.createElement('textarea');
      textarea.value = text;
      textarea.setAttribute('readonly', '');
      textarea.style.position = 'absolute';
      textarea.style.left = '-9999px';
      document.body.appendChild(textarea);
      textarea.select();

      let successful;
      try {
        successful = document.execCommand('copy');
      } catch (error) {
        successful = false;
      }

      document.body.removeChild(textarea);
      return successful;
    };

    const copyText = async (text) => {
      if (!text) {
        return false;
      }
      if (navigator.clipboard && typeof navigator.clipboard.writeText === 'function') {
        try {
          await navigator.clipboard.writeText(text);
          return true;
        } catch (error) {
          // fall back to execCommand
        }
      }
      return fallbackCopyText(text);
    };

    const flashButton = (button, label) => {
      if (!button) return;
      const useOverlay = button.dataset.flashMode === 'overlay';
      if (useOverlay) {
        button.dataset.flashLabel = label;
        button.classList.add('is-flashing');
        button.disabled = true;
        setTimeout(() => {
          button.classList.remove('is-flashing');
          button.dataset.flashLabel = '';
          button.disabled = false;
        }, 1800);
        return;
      }
      const originalLabel = button.textContent.trim();
      button.textContent = label;
      button.disabled = true;
      setTimeout(() => {
        button.textContent = originalLabel;
        button.disabled = false;
      }, 2000);
    };

    if (latencyEl) {
      const startedAt = performance.now();
      fetch('/healthz', { headers: { Accept: 'application/json' } })
        .then((response) => {
          const elapsed = Math.round(performance.now() - startedAt);
          latencyEl.textContent = `${elapsed} ms`;
          if (!response.ok) {
            throw new Error('Response not OK');
          }
        })
        .catch(() => {
          latencyEl.textContent = 'Unavailable';
          latencyEl.classList.add('pill-muted');
        });
    }

    document.querySelectorAll('[data-copy-text]').forEach((button) => {
      button.addEventListener('click', async () => {
        const text = button.getAttribute('data-copy-text');
        const copied = await copyText(text);
        flashButton(button, copied ? 'Copied' : 'Copy failed');
      });
    });

    if (headersCopyButton) {
      const headerPairs = <%- JSON.stringify(headers || []) %>;
      const headersPayload = headerPairs.reduce((acc, [key, value]) => {
        if (acc[key]) {
          acc[key] = Array.isArray(acc[key]) ? [...acc[key], value] : [acc[key], value];
        } else {
          acc[key] = value;
        }
        return acc;
      }, {});

      headersCopyButton.addEventListener('click', async () => {
        const copied = await copyText(JSON.stringify(headersPayload, null, 2));
        flashButton(headersCopyButton, copied ? 'Copied' : 'Copy failed');
      });
    }

    if (headersToggleButton) {
      const targetId = headersToggleButton.getAttribute('aria-controls');
      const content = document.getElementById(targetId);
      const labelEl = headersToggleButton.querySelector('[data-toggle-label]');

      const setState = (expanded) => {
        headersToggleButton.setAttribute('aria-expanded', String(expanded));
        headersToggleButton.dataset.expanded = String(expanded);
        if (content) {
          content.hidden = !expanded;
        }
        if (labelEl) {
          labelEl.textContent = expanded ? 'Hide' : 'Show';
        }
      };

      setState(false);

      headersToggleButton.addEventListener('click', () => {
        const isExpanded = headersToggleButton.getAttribute('aria-expanded') === 'true';
        setState(!isExpanded);
      });
    }

    const revealSecondaryIp = (ip) => {
      if (!secondaryBlocks.length || !secondaryValueEls.length || !ip) {
        return;
      }
      secondaryValueEls.forEach((valueEl) => {
        valueEl.textContent = ip;
      });
      secondaryCopyButtons.forEach((button) => {
        button.setAttribute('data-copy-text', ip);
      });
      secondaryBlocks.forEach((block) => {
        block.hidden = false;
      });
    };

    const fetchSecondaryIp = async () => {
      if (!secondaryBlocks.length) {
        return;
      }
      try {
        const apiUrl = new URL(
          isMainIpv6 ? 'http://v4.nossl.sh/api/request-info' : 'http://v6.nossl.sh/api/request-info'
        );
        if (shareReportId) {
          apiUrl.searchParams.set('reportId', shareReportId);
        }

        const response = await fetch(apiUrl.toString(), {
          headers: { Accept: 'application/json' },
          cache: 'no-store',
          mode: 'cors',
        });

        if (!response.ok) {
          return;
        }

        const payload = await response.json();
        const candidateIp = isMainIpv6
          ? (payload?.clientIpv4 || payload?.clientIp)
          : (payload?.clientIpv6 || payload?.clientIp);
        const secondaryIp = (candidateIp || '').trim();
        if (!secondaryIp || secondaryIp === mainIp) {
          return;
        }

        revealSecondaryIp(secondaryIp);
      } catch (error) {
        // Ignore errors; secondary IP info is optional.
      }
    };

    fetchSecondaryIp();

    const generateBeaconUniq = () => {
      if (window.crypto?.getRandomValues) {
        const bytes = new Uint8Array(10);
        window.crypto.getRandomValues(bytes);
        return Array.from(bytes, (byte) => byte.toString(16).padStart(2, '0')).join('');
      }
      return Math.random().toString(36).slice(2, 14);
    };

    const buildFreeGeoUrl = (ip) => `/free-geo-ip?${encodeURIComponent(ip)}`;

    const setBeaconResolver = (value, {linkToGeo = false, resolverName = ''} = {}) => {
      if (!beaconResolverEl) {
        return;
      }
      const label = value || 'n/a';
      const metaLabel = resolverName || '';
      if (beaconResolverMetaEl) {
        if (metaLabel) {
          beaconResolverMetaEl.textContent = metaLabel;
          beaconResolverMetaEl.hidden = false;
        } else {
          beaconResolverMetaEl.textContent = '';
          beaconResolverMetaEl.hidden = true;
        }
      }
      beaconResolverEl.textContent = '';
      if (label === 'n/a') {
        beaconResolverEl.textContent = label;
        return;
      }
      if (linkToGeo) {
        const link = document.createElement('a');
        link.href = buildFreeGeoUrl(label);
        link.rel = 'nofollow';
        link.textContent = label;
        beaconResolverEl.appendChild(link);
      } else {
        beaconResolverEl.textContent = label;
      }
    };

    const fetchBeacon = async (attempt = 1, uniq ='') => {
      if (!beaconResolverEl) {
        return;
      }
      try {
        uniq = uniq === ''  ? generateBeaconUniq() : uniq;
        const apiUrl = isDev
          ? new URL('/api/beacon', window.location.origin)
          : new URL(`http://${uniq}${beaconHostSuffix}/api/beacon`);
        if (shareReportId) {
          apiUrl.searchParams.set('reportId', shareReportId);
        }
        const response = await fetch(apiUrl.toString(), {
          headers: { Accept: 'application/json' },
          cache: 'no-store',
          mode: 'cors',
        });
        if (!response.ok) {
          if (response.status === 404 && attempt < 4) {
            setTimeout(() => fetchBeacon(attempt + 1, uniq), 2000*attempt);
            return;
          }
          setBeaconResolver('');
          return;
        }
        const payload = await response.json();
        const resolverIp = payload?.resolver_ip || '';
        const resolverName = payload?.resolver_name || payload?.resolverName || '';
        setBeaconResolver(resolverIp, {
          linkToGeo: Boolean(resolverIp),
          resolverName,
        });
      } catch (error) {
        setBeaconResolver('');
      }
    };

    fetchBeacon();

    if (shareButton) {
      const shareUrl = shareButton.getAttribute('data-share-url') || '';
      const shareLabel = shareButton.querySelector('[data-share-label]');

      const setShareLabel = (label) => {
        if (shareLabel) {
          shareLabel.textContent = label;
        } else {
          shareButton.textContent = label;
        }
      };

      shareButton.addEventListener('click', async () => {
        if (!shareUrl) {
          return;
        }
        setShareLabel('Copying...');
        shareButton.disabled = true;
        try {
          const copied = await copyText(shareUrl);
          setShareLabel(copied ? 'Link copied' : 'Copy failed');
        } finally {
          setTimeout(() => {
            setShareLabel('Share');
            shareButton.disabled = false;
          }, 2000);
        }
      });
    }

    document.querySelectorAll('.card__header_clickable').forEach(header => {
      header.addEventListener('click', (e) => {
        if (e.target.closest('a, button')) {
          return;
        }
        const toggleButton = header.querySelector('[data-toggle-headers]');
        if (toggleButton) {
          toggleButton.click();
        }
      });
    });
  })();
</script>
