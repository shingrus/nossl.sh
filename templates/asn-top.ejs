<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= pageTitle %></title>
    <meta name="description" content="<%= pageDescription %>" />
    <link rel="icon" href="/favicon.ico" type="image/svg+xml" />
    <link rel="stylesheet" href="/static/styles.css?v=2" />
  </head>
  <body>
    <%
      const headerNote = pageTitle;
      const resolvedTableEyebrow = typeof tableEyebrow === 'string' ? tableEyebrow : 'Autonomous systems';
      const tableTitleText = typeof tableTitle !== 'undefined' && tableTitle
        ? tableTitle
        : `Top ASNs by ${primaryAmountLabel}`;
      const tableSummaryText = typeof tableSummary !== 'undefined' && tableSummary
        ? tableSummary
        : 'Each entry links to the ASN detail page and related ASNs.';
      const showRelatedAsnsColumn = typeof showRelatedAsns !== 'undefined' ? showRelatedAsns !== false : true;
      const resolvedRelatedAsnsLabel = typeof relatedAsnsLabel !== 'undefined' && relatedAsnsLabel
        ? relatedAsnsLabel
        : 'Related ASNs';
      const paginationData = typeof pagination !== 'undefined' ? pagination : null;
      const totalColumnCount = 4 + (showSecondaryAmount ? 1 : 0) + (showRelatedAsnsColumn ? 1 : 0);
      const relatedLinks = Array.isArray(pageLinks)
        ? pageLinks.filter((link) => !link.active).map((link) => `<a href="${link.path}">${link.label}</a>`)
        : [];
      const footerLines = [
        'Return to the <a href="/">main nossl.sh page</a>.',
        relatedLinks.length ? `Related ASN rankings: ${relatedLinks.join(', ')}.` : null,
      ].filter(Boolean);
    %>
    <%- include('partials/header', {headerNote}) %>

    <main class="container page">
      <section class="card hero">
        <div class="card__header">
          <div>
            <p class="eyebrow"><%= resolvedTableEyebrow %></p>
            <h1 class="card__title"><%= heroTitle %></h1>
            <p class="panel__summary"><%= heroSubtitle %></p>
          </div>
        </div>
        <% if (Array.isArray(pageLinks) && pageLinks.length) { %>
          <div class="pill-row" style="margin-top: 12px;">
            <% pageLinks.forEach((link) => { %>
              <% if (link.active) { %>
                <span class="pill"><%= link.label %></span>
              <% } else { %>
                <a class="pill pill-muted" href="<%= link.path %>"><%= link.label %></a>
              <% } %>
            <% }) %>
          </div>
        <% } %>
      </section>

      <% if (errorMessage) { %>
        <section class="panel">
          <header class="panel__header">
            <div>
              <p class="eyebrow">Notice</p>
              <h2>Rankings unavailable</h2>
              <p class="panel__summary"><%= errorMessage %></p>
            </div>
          </header>
        </section>
      <% } else { %>
        <section class="panel">
          <header class="panel__header">
            <div>
              <p class="eyebrow">Leaderboard</p>
              <h2><%= tableTitleText %></h2>
              <p class="panel__summary"><%= tableSummaryText %></p>
            </div>
          </header>
          <div class="table-wrapper">
            <table>
              <thead>
                <tr>
                  <th scope="col">Rank</th>
                  <th scope="col">ASN</th>
                  <th scope="col">Organization</th>
                  <th scope="col"><%= primaryAmountLabel %></th>
                  <% if (showSecondaryAmount) { %>
                    <th scope="col"><%= secondaryAmountLabel %></th>
                  <% } %>
                  <% if (showRelatedAsnsColumn) { %>
                    <th scope="col"><%= resolvedRelatedAsnsLabel %></th>
                  <% } %>
                </tr>
              </thead>
              <tbody>
                <% if (!entries.length) { %>
                  <tr>
                    <td colspan="<%= totalColumnCount %>">No ASN entries available.</td>
                  </tr>
                <% } else { %>
                  <% entries.forEach((entry, index) => { %>
                    <% const relatedAsns = Array.isArray(entry.relatedAsns) ? entry.relatedAsns : []; %>
                    <tr>
                      <td class="mono"><%= entry.rank ?? index + 1 %></td>
                      <td><a href="/as<%= entry.asn %>">AS<%= entry.asn %></a></td>
                      <td>
                        <% if (entry.orgSlug) { %>
                          <a href="/asn-<%= entry.orgSlug %>"><%= entry.displayOrganization %></a>
                        <% } else { %>
                          <div><%= entry.displayOrganization %></div>
                        <% } %>
                      </td>
                      <td class="mono"><%= entry.primaryAmountDisplay ?? 'N/A' %></td>
                      <% if (showSecondaryAmount) { %>
                        <td class="mono"><%= entry.secondaryAmountDisplay ?? 'N/A' %></td>
                      <% } %>
                      <% if (showRelatedAsnsColumn) { %>
                        <td>
                          <% if (relatedAsns.length) { %>
                            <div class="pill-row">
                              <% relatedAsns.forEach((related) => { %>
                                <a class="pill pill-muted" href="/as<%= related.asn %>">AS<%= related.asn %></a>
                              <% }) %>
                            </div>
                          <% } else { %>
                            <span class="muted">N/A</span>
                          <% } %>
                        </td>
                      <% } %>
                    </tr>
                  <% }) %>
                <% } %>
              </tbody>
            </table>
          </div>
          <% if (paginationData) { %>
            <div class="pill-row" style="margin-top: 16px;">
              <% if (paginationData.hasPrev) { %>
                <a class="pill pill-muted" href="<%= paginationData.prevUrl %>">Previous</a>
              <% } %>
              <span class="pill">Page <%= paginationData.page %> / <%= paginationData.totalPages %></span>
              <% if (paginationData.hasNext) { %>
                <a class="pill pill-muted" href="<%= paginationData.nextUrl %>">Next</a>
              <% } %>
            </div>
            <p class="muted" style="margin-top: 8px;">
              Total ASNs: <span class="mono"><%= paginationData.totalCount.toLocaleString('en-US') %></span>
            </p>
          <% } %>
        </section>
      <% } %>

      <%- include('partials/support-block') %>
    </main>

    <%- include('partials/footer', {generationTimeMs, footerLines, generatedAt}) %>
  </body>
</html>
