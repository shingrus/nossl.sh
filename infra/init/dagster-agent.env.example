# Runtime environment for /etc/init.d/dagster-cloud-agent

DAGSTER_HOME=/opt/nossl/dagster_home
WORKDIR=/opt/nossl/repo

# Dagster job/runtime secrets.
# Fill only the values your schedules need.
# PDB_KEY=
# PGSQL=postgresql://user:password@host:5432/dbname
# MAINTENANCE_TOKEN=
# OPENAI_API_KEY=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# GITHUB_TOKEN=
