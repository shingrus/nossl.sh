# Runtime environment for nossl-worker.service.
# Installed at /etc/nossl/worker.env (root:nossl, 0640). Edit with: sudoedit /etc/nossl/worker.env
# Secrets live only here: never put them in Hatchet task inputs, outputs, or log lines.

# --- Hatchet ---------------------------------------------------------------
# API token from the Hatchet dashboard for the nossl-prod tenant.
HATCHET_CLIENT_TOKEN=

# --- Paths (default matches init-hatchet-runner-vm.sh) -----------------------------------
NOSSL_DATA_DIR=/var/lib/nossl

# --- PostgreSQL (Supabase) ------------------------------------------------------
# Use the session pooler connection string (IPv4, port 5432), not the direct one.
# Example: postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
PGSQL=

# --- Cloudflare R2 (final artifacts for the pull agent) -------------------------
R2_ACCOUNT_ID=
R2_BUCKET=nossl-sh-dbs
# Read & write token scoped to the bucket above.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# --- GitHub release publishing --------------------------------------------------
# Fine-grained token with "Contents: read and write" on the repo below.
GITHUB_TOKEN=
GITHUB_REPO=shingrus/nossl.sh

# --- Job secrets ----------------------------------------------------------------
# PeeringDB API key (pdb_asn_geo).
PDB_KEY=
# nossl.sh maintenance token for the unknown-IPs API (geo build rDNS step).
MAINTENANCE_TOKEN=
UNKNOWN_IPS_URL=http://nossl.sh/api/unknown
# OpenAI key (rDNS rules generation).
OPENAI_API_KEY=

# --- Freshness alerts (optional) ------------------------------------------------
# healthchecks.io ping URLs, pinged after each successful publish (ASN job uses HC_PING_ASN).
HC_PING_ASN=
HC_PING_GEO=
